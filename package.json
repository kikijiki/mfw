{
	"name": "mfw",
	"version": "0.1.0",
	"author": "Matteo Bernacchia <dev@kikijiki.com>",
	"license": "MIT",
	"private": true,
	"description": "Autonomous project orchestrator for AI coding agents",
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "bunx biome check . && tsc --noEmit -p tsconfig.json",
		"fix": "bunx biome check --write .",
		"test": "bun run tools/root-test.ts",
		"dev": "bun run --cwd apps/start dev",
		"build": "bun run --cwd apps/start build",
		"deploy:mfw": "bun run packages/daemon/src/deploy-mfw.ts",
		"test:deployment-smoke": "bun run packages/daemon/src/deployment-smoke.ts",
		"verify:host-amd": "bun run packages/daemon/src/verify-host-amd.ts",
		"verify:runpod-live": "bun run packages/daemon/src/verify-runpod-live.ts",
		"start": "bun run --cwd apps/start start"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.1",
		"@types/bun": "1.3.14",
		"drizzle-kit": "^0.31.10",
		"typescript": "^5.6.0"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "^1.0.0",
		"@libsql/client": "^0.17.4",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@trpc/server": "^11.18.0",
		"drizzle-orm": "^0.45.2",
		"superjson": "^2.2.6",
		"zod": "^4.4.3"
	}
}

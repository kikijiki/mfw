# mfw daemon: systemd user service.
# Install:  cp packaging/mfw-server.service ~/.config/systemd/user/
#           systemctl --user daemon-reload
#           systemctl --user enable --now mfw-server
# Logs:     journalctl --user -u mfw-server -f
# First run: the setup token is in $MFW_HOME/setup-token (never in the log), or
#           run `mfw auth setup-token`. Recovery: `mfw auth --help`.
[Unit]
Description=mfw: local autonomous project orchestrator
After=network.target

[Service]
Type=simple
# A compiled install (docs/install.md) runs from its own read-only directory:
#   ExecStart=/opt/mfw/bin/mfw server
# and needs neither WorkingDirectory nor bun on PATH. Use that line in place of
# the two below.
#
# From a checkout (development): adjust WorkingDirectory to it. The single app
# serves UI + /api/trpc and boots the orchestrator in-process. Build once
# (`bun run build`) then run the Nitro (bun-preset) server output under Bun.
WorkingDirectory=%h/dev/mfw
ExecStart=/usr/bin/env bun run apps/start/.output/server/index.mjs
Restart=on-failure
RestartSec=2
# A user manager's PATH is minimal. bun, bwrap and tmux must all be found here:
# without bwrap autonomous runs are refused. Add the directory that holds them
# if yours is elsewhere, and keep it free of directories agents can write.
Environment=PATH=%h/.nix-profile/bin:/nix/var/nix/profiles/default/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
Environment=MFW_HOME=%h/.local/share/mfw
Environment=PORT=7777
Environment=HOST=127.0.0.1
# Stay on loopback: the server refuses a non-loopback HOST without TLS or a
# trusted proxy. To reach it from another device, publish it through a TLS proxy
# on its own origin and name both sides here (see docs/exposure.md):
#   sudo tailscale serve --bg --https=8443 unix:$HOME/.local/share/mfw/serve/mfw.sock
#Environment=MFW_LISTEN_SOCKET=%h/.local/share/mfw/serve/mfw.sock
#Environment=MFW_ALLOWED_HOSTS=mybox.tail1234.ts.net:8443

# Agent runs are detached tmux sessions that are meant to survive a daemon
# restart, the supervisor re-adopts them on boot. The default KillMode of
# control-group kills the entire cgroup on stop/restart, which silently broke
# that: every restart killed the in-flight runs, and they finalized as
# "session ended without recording an exit". `process` signals only the daemon.
#
# Trade-off: `systemctl --user stop mfw-server` now leaves running agents alive. Stop
# them from the UI first, or `tmux -L mfw kill-server` to clear them by hand.
KillMode=process

# A child being OOM-killed must not tear down the orchestrator with it.
OOMPolicy=continue

# Runs live under this unit's cgroup, so a runaway agent build is accounted here.
# Uncomment to cap it, leave generous headroom, since a legitimate agent may run
# a full build or test suite.
#MemoryHigh=24G
#MemoryMax=32G

[Install]
WantedBy=default.target
